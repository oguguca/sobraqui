# Copie para .env.local e preencha. Nunca faça commit de .env.local.

# Neon > Connection Details. Use a URL com "-pooler" para o app
# e a URL direta (sem "-pooler") para as migrações.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Better Auth. Gere o segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL pública do app (em produção: https://seu-dominio).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Libera o cadastro. Deixe "false" depois de criar sua conta.
ALLOW_SIGNUP="false"

# E-mail de recuperação de senha (Resend). Sem isso, em desenvolvimento o link
# aparece no terminal; em produção o envio falha.
RESEND_API_KEY=""
EMAIL_FROM="Sobraqui <nao-responda@seu-dominio>"

# Login com Google (opcional). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Open Finance via Meu Pluggy (opcional). dashboard.pluggy.ai > Aplicações.
# Item ID: conexão "MeuPluggy" criada na aplicação. Vários itens separados por vírgula.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
PLUGGY_ITEM_IDS=""
