# Copie para .env.local e preencha. Nunca faça commit de .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable ou anon). É segura no navegador porque o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública do app, usada nos links de e-mail (confirmação e recuperação de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Libera a página de cadastro. Deixe "false" depois de criar sua conta.
# Desative também o cadastro no painel do Supabase (Authentication > Sign In / Providers).
ALLOW_SIGNUP=false

# A service role key NÃO é usada por este projeto. Não a adicione aqui.
